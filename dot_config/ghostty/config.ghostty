# Ghostty configuration for daily development on macOS.

# Typography
font-family = "Maple Mono NF CN"
font-size = 14
window-colorspace = display-p3

# Theme
theme = light:Rose Pine Dawn,dark:TokyoNight Storm
window-theme = auto

# Window appearance
background-opacity = 0.94
background-blur = true
window-padding-x = 10
window-padding-y = 8
macos-titlebar-style = transparent

# Shell integration and terminal behavior
shell-integration = zsh
shell-integration-features = cursor,sudo,title,ssh-env,path
window-save-state = always
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

# Interaction
macos-option-as-alt = left
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = true
quit-after-last-window-closed = true
clipboard-paste-protection = true

# Convenience
scrollback-limit = 50000000
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify,no-bell
notify-on-command-finish-after = 8s

# Quick terminal
keybind = global:cmd+shift+backquote=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 45%
quick-terminal-autohide = true
