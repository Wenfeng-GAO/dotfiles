# Portable zsh configuration managed by chezmoi.

export PATH="$HOME/bin:$HOME/.local/bin:$HOME/go/bin:$PATH"
export EDITOR="nvim"
export VISUAL="$EDITOR"

# Oh My Zsh.
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_THEME="robbyrussell"
plugins=(git kubectl zsh-autosuggestions zsh-history-substring-search)

if [ -s "$ZSH/oh-my-zsh.sh" ]; then
  source "$ZSH/oh-my-zsh.sh"
  unalias gsd 2>/dev/null
fi

# Local-only company/internal config and secrets.
[ -f "$HOME/.config/zsh/private.env" ] && source "$HOME/.config/zsh/private.env"
[ -f "$HOME/.config/zsh/company.zsh" ] && source "$HOME/.config/zsh/company.zsh"

# Public personal modules.
[ -f "$HOME/.config/zsh/aliases.zsh" ] && source "$HOME/.config/zsh/aliases.zsh"

# Node via nvm.
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"
  nvm use --silent default >/dev/null 2>&1
fi

# Prompt.
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

proxy_rprompt_segment() {
  if [[ -n "$HTTP_PROXY$http_proxy$HTTPS_PROXY$https_proxy$ALL_PROXY$all_proxy" ]]; then
    print -n "%{%F{245}%}proxy:on%{%f%}"
  fi
}

RPROMPT='$(proxy_rprompt_segment)'

# Tool paths.
if [ -n "${NVM_BIN:-}" ]; then
  export PATH="$NVM_BIN:$PATH"
fi

[ -d "$HOME/.opencode/bin" ] && export PATH="$HOME/.opencode/bin:$PATH"
[ -d "$HOME/.gstack/repos/gstack/bin" ] && export PATH="$HOME/.gstack/repos/gstack/bin:$PATH"
if [ -d "$HOME/.npm-global/bin" ]; then
  path=("${path[@]:#"$HOME/.npm-global/bin"}" "$HOME/.npm-global/bin")
  export PATH
fi
[ -d "$HOME/.pulumi/bin" ] && export PATH="$HOME/.pulumi/bin:$PATH"
[ -d "$HOME/Library/Python/3.14/bin" ] && export PATH="$HOME/Library/Python/3.14/bin:$PATH"
[ -d "$HOME/Downloads/jdk-21.0.1.jdk/Contents/Home" ] && export JAVA_HOME="$HOME/Downloads/jdk-21.0.1.jdk/Contents/Home"
[ -n "${JAVA_HOME:-}" ] && export PATH="$JAVA_HOME/bin:$PATH"

# Codex shortcut with local proxy.
alias cdx='https_proxy=http://127.0.0.1:7897 http_proxy=http://127.0.0.1:7897 all_proxy=socks5://127.0.0.1:7897 NO_PROXY=".alipay.com,alipay.com,localhost,127.0.0.1" no_proxy=".alipay.com,alipay.com,localhost,127.0.0.1" codex -a never -s workspace-write'

# lsd shortcuts.
alias ll='lsd -l'
alias la='lsd -la'
alias lt='lsd -lt'
alias lg='lsd -lg --git'
ltree() {
  local depth="${1:-2}"

  if [[ "$depth" == <-> ]]; then
    shift
  else
    depth=2
  fi

  lsd --tree --depth "$depth" "$@"
}

alias nosleep='caffeinate -dimsu'

[ -f "$HOME/.config/zsh/tools.zsh" ] && source "$HOME/.config/zsh/tools.zsh"
export PATH="$HOME/.utoo-proxy:$PATH"

# 本机密钥(token 等)—— 隔离在 chezmoi 管理之外,不进 dotfiles/GitHub
[ -f "$HOME/.config/zsh/secrets.zsh" ] && source "$HOME/.config/zsh/secrets.zsh"

# gripmd — 用 grip 起本地 GitHub 风格 markdown 预览服务(配合 cmux 浏览器面板用)
# 用法: gripmd [文件或目录] [端口]   默认 README.md / 6419
# 例:   gripmd .planning/notes/mock-ui-design-spec.md
#        gripmd docs 6420          # 目录模式,可点选多个文件
gripmd() {
  local target="${1:-README.md}"
  local port="${2:-6419}"
  if [ ! -e "$target" ]; then
    print -P "%F{red}❌ 找不到: $target%f" >&2
    return 1
  fi
  print -P "%F{green}📖 渲染:%f $target"
  print -P "%F{blue}🔗 http://localhost:$port%f  (cmux 浏览器面板打开,Ctrl+C 退出)"
  grip "$target" "$port"
}
