#!/usr/bin/env bash

set -euo pipefail

CLD_BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
USE_PROXY=true
API_TIMEOUT_MS=""
CAST_RECORD="${CAST_RECORD:-0}"
ANTHROPIC_BASE_URL=""
ANTHROPIC_AUTH_TOKEN=""
ANTHROPIC_API_KEY=""
ANTHROPIC_DEFAULT_HAIKU_MODEL=""
ANTHROPIC_DEFAULT_SONNET_MODEL=""
ANTHROPIC_DEFAULT_OPUS_MODEL=""
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=""
CLD_ENV_FILE="${CLD_ENV_FILE:-$HOME/.config/cld/env}"

# Agent/runtime callers may select a route explicitly. Treat the env file as
# defaults and restore those per-process overrides after loading credentials.
cld_route_provider_override_set="${CLD_ROUTE_PROVIDER+x}"
cld_route_provider_override="${CLD_ROUTE_PROVIDER-}"
cld_route_model_override_set="${CLD_ROUTE_MODEL+x}"
cld_route_model_override="${CLD_ROUTE_MODEL-}"
cld_claude_bin_override_set="${CLD_CLAUDE_BIN+x}"
cld_claude_bin_override="${CLD_CLAUDE_BIN-}"

if [[ -r "$CLD_ENV_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CLD_ENV_FILE"
fi

if [[ "$cld_route_provider_override_set" == "x" ]]; then
  CLD_ROUTE_PROVIDER="$cld_route_provider_override"
fi
if [[ "$cld_route_model_override_set" == "x" ]]; then
  CLD_ROUTE_MODEL="$cld_route_model_override"
fi
if [[ "$cld_claude_bin_override_set" == "x" ]]; then
  CLD_CLAUDE_BIN="$cld_claude_bin_override"
fi
unset cld_route_provider_override_set cld_route_provider_override
unset cld_route_model_override_set cld_route_model_override
unset cld_claude_bin_override_set cld_claude_bin_override

CLAUDE_BIN="${CLD_CLAUDE_BIN:-}"
if [[ -z "$CLAUDE_BIN" ]]; then
  CLAUDE_BIN="$(command -v claude 2>/dev/null || true)"
fi
CFUSE_CLAUDE_BIN="${CLD_CFUSE_BIN:-$HOME/.local/bin/cfuse-claude-code}"

usage() {
  cat <<'USAGE'
Usage:
  cld <provider> [model] [claude args...]

  Provider and model:
  anthropic (default model sonnet, optional: haiku/sonnet/opus)
  ant      k2.5  -> Kimi-K2.5
           glm5  -> GLM-5
           glm5.2 -> GLM-5.2[1m]
  deepseek (default model deepseek-v4-pro[1m], optional: pro/flash)
  moonshot (default model Kimi-K3[1m], optional: k3/k2.5)
  zenmux   (default model anthropic/claude-sonnet-4.5, optional: haiku/sonnet/opus)
  cfuse    CodeFuse default model through its Claude Code-compatible mode

Options:
  --proxy   Kept for compatibility; proxy env vars are injected by default
  --cast    Record the session with asciinema to ~/code/ant/agent-casts/
Examples:
  cld anthropic
  cld anthropic opus --print
  cld ant k2.5
  cld ant glm5 --print
  cld ant glm5.2 --print
  cld deepseek
  cld deepseek flash --print
  cld moonshot --help
  cld moonshot
  cld moonshot k2.5
  cld --proxy ant glm5
  cld zenmux
  cld zenmux haiku
  cld zenmux opus --print
  cld cfuse
  cld cfuse --print
USAGE
}

require_env() {
  local name="$1"
  local provider="$2"

  if [[ -z "${!name:-}" ]]; then
    echo "cld: missing $name for provider '$provider'" >&2
    echo "cld: add it to $CLD_ENV_FILE" >&2
    exit 1
  fi
}

check_claude_update() {
  if [[ "${CLD_SKIP_UPDATE_CHECK:-}" == "1" ]]; then
    return
  fi

  if ! command -v npm >/dev/null 2>&1 || [[ -z "$CLAUDE_BIN" || ! -x "$CLAUDE_BIN" ]]; then
    return
  fi

  local current_version latest_version reply
  local npm_env=()

  current_version="$("$CLAUDE_BIN" --version 2>/dev/null | awk '{print $1}' || true)"

  if [[ "$USE_PROXY" == "true" ]]; then
    npm_env+=(https_proxy="http://127.0.0.1:7897")
    npm_env+=(http_proxy="http://127.0.0.1:7897")
    npm_env+=(all_proxy="socks5://127.0.0.1:7897")
    npm_env+=(NO_PROXY=".alipay.com,alipay.com,localhost,127.0.0.1")
    npm_env+=(no_proxy=".alipay.com,alipay.com,localhost,127.0.0.1")
  fi

  latest_version="$(env "${npm_env[@]}" npm view @anthropic-ai/claude-code version --fetch-timeout=8000 --fetch-retries=0 2>/dev/null || true)"

  if [[ -z "$current_version" || -z "$latest_version" || "$current_version" == "$latest_version" ]]; then
    return
  fi

  echo "cld: claude-code update available: $current_version -> $latest_version" >&2

  if [[ -t 0 && -t 2 ]]; then
    printf "cld: update claude-code to %s now? [y/N] " "$latest_version" >&2
    read -r reply

    case "$reply" in
      y|Y|yes|YES)
        if ! NPM_SAFE_UPDATE_BIN_PATH="$CLAUDE_BIN" \
          NPM_SAFE_UPDATE_PREFIX="$(npm prefix -g)" \
          "$CLD_BIN_DIR/npm-safe-self-update" @anthropic-ai/claude-code claude "$latest_version" cld; then
          echo "cld: claude-code update failed; continuing with $current_version" >&2
        fi
        ;;
      *)
        ;;
    esac
  else
    echo "cld: run: npm install -g @anthropic-ai/claude-code@latest" >&2
  fi
}

exec_cfuse_passthrough() {
  if [[ ! -x "$CFUSE_CLAUDE_BIN" ]]; then
    echo "Error: cfuse Claude-compatible wrapper not found or not executable: $CFUSE_CLAUDE_BIN" >&2
    exit 127
  fi

  exec "$CFUSE_CLAUDE_BIN" "$@"
}

is_claude_passthrough_arg() {
  case "${1:-}" in
    -p|--print|--output-format|--input-format|--verbose|--strict-mcp-config|--permission-mode|--mcp-config|--resume|--continue|--append-system-prompt)
      return 0
      ;;
  esac
  return 1
}

exec_claude_passthrough() {
  local provider="${CLD_ROUTE_PROVIDER:-anthropic}"
  local model="${CLD_ROUTE_MODEL:-}"

  provider="$(printf '%s' "$provider" | tr '[:upper:]' '[:lower:]')"
  model="$(printf '%s' "$model" | tr '[:upper:]' '[:lower:]')"

  case "$provider" in
    anthropic)
      if [[ -n "$model" ]]; then
        exec "$0" anthropic "$model" "$@"
      fi
      exec "$0" anthropic "$@"
      ;;
    ant)
      exec "$0" ant "${model:-k2.5}" "$@"
      ;;
    deepseek)
      if [[ -n "$model" ]]; then
        exec "$0" deepseek "$model" "$@"
      fi
      exec "$0" deepseek "$@"
      ;;
    moonshot)
      exec "$0" moonshot "${model:-k3}" "$@"
      ;;
    zenmux)
      if [[ -n "$model" ]]; then
        exec "$0" zenmux "$model" "$@"
      fi
      exec "$0" zenmux "$@"
      ;;
    cfuse)
      exec_cfuse_passthrough "$@"
      ;;
    *)
      echo "Unsupported CLD_ROUTE_PROVIDER: $provider (supported: anthropic, ant, deepseek, moonshot, zenmux, cfuse)" >&2
      exit 1
      ;;
  esac
}

case "${1:-}" in
  --version|-v)
    check_claude_update
    exec "$CLAUDE_BIN" --version
    ;;
esac

if is_claude_passthrough_arg "${1:-}"; then
  exec_claude_passthrough "$@"
fi

while [[ "$#" -gt 0 ]]; do
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    --proxy)
      USE_PROXY=true
      shift
      ;;
    --cast)
      export CAST_RECORD=1
      shift
      ;;
    -h|--help|help)
      usage
      exit 0
      ;;
    --*)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

if is_claude_passthrough_arg "${1:-}"; then
  exec_claude_passthrough "$@"
fi

if [[ "$#" -lt 1 ]]; then
  usage
  exit 1
fi

provider="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
shift

case "$provider" in
  anthropic)
    ANTHROPIC_MODEL="sonnet"

    if [[ "$#" -gt 0 ]]; then
      case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
        haiku)
          ANTHROPIC_MODEL="haiku"
          shift
          ;;
        sonnet)
          ANTHROPIC_MODEL="sonnet"
          shift
          ;;
        opus)
          ANTHROPIC_MODEL="opus"
          shift
          ;;
      esac
    fi
    ;;

  ant)
    if [[ "$#" -lt 1 ]]; then
      echo "ant requires a second argument: k2.5, glm5, or glm5.2" >&2
      usage
      exit 1
    fi

    require_env CLD_ANT_ANTHROPIC_BASE_URL "$provider"
    require_env CLD_ANT_ANTHROPIC_AUTH_TOKEN "$provider"

    model_choice="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
    shift

    ANTHROPIC_BASE_URL="$CLD_ANT_ANTHROPIC_BASE_URL"
    ANTHROPIC_AUTH_TOKEN="$CLD_ANT_ANTHROPIC_AUTH_TOKEN"

    case "$model_choice" in
      k2.5|k2|kimi-k2.5|kimi_k2.5)
        ANTHROPIC_MODEL="Kimi-K2.5"
        ;;
      glm5|glm-5|glm)
        ANTHROPIC_MODEL="GLM-5"
        ;;
      glm5.2|glm-5.2|glm52|glm_5.2)
        ANTHROPIC_DEFAULT_HAIKU_MODEL="GLM-5.2[1m]"
        ANTHROPIC_DEFAULT_SONNET_MODEL="$ANTHROPIC_DEFAULT_HAIKU_MODEL"
        ANTHROPIC_DEFAULT_OPUS_MODEL="$ANTHROPIC_DEFAULT_HAIKU_MODEL"
        ANTHROPIC_MODEL="$ANTHROPIC_DEFAULT_SONNET_MODEL"
        CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1"
        ;;
      *)
        echo "Unknown Ant model: $model_choice (supported: k2.5 / glm5 / glm5.2)" >&2
        usage
        exit 1
        ;;
    esac
    ;;

  moonshot)
    require_env CLD_MOONSHOT_ANTHROPIC_BASE_URL "$provider"
    require_env CLD_MOONSHOT_ANTHROPIC_AUTH_TOKEN "$provider"

    ANTHROPIC_BASE_URL="$CLD_MOONSHOT_ANTHROPIC_BASE_URL"
    ANTHROPIC_AUTH_TOKEN="$CLD_MOONSHOT_ANTHROPIC_AUTH_TOKEN"
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1"

    # default to k3 (provider-side id drift 2026-07-19: Kimi-K3[1m] dropped,
    # api.kimi.com now accepts `k3`/`kimi-k3`; wire all three Claude slots to it
    ANTHROPIC_DEFAULT_HAIKU_MODEL="k3"
    ANTHROPIC_DEFAULT_SONNET_MODEL="k3"
    ANTHROPIC_DEFAULT_OPUS_MODEL="k3"
    ANTHROPIC_MODEL="$ANTHROPIC_DEFAULT_SONNET_MODEL"

    if [[ "$#" -gt 0 ]]; then
      case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
        k3|kimi-k3|kimi_k3)
          ANTHROPIC_DEFAULT_HAIKU_MODEL="k3"
          ANTHROPIC_DEFAULT_SONNET_MODEL="k3"
          ANTHROPIC_DEFAULT_OPUS_MODEL="k3"
          ANTHROPIC_MODEL="$ANTHROPIC_DEFAULT_SONNET_MODEL"
          shift
          ;;
        k2.5|k2|kimi-k2.5|kimi_k2.5)
          ANTHROPIC_DEFAULT_HAIKU_MODEL="Kimi-K2.5"
          ANTHROPIC_DEFAULT_SONNET_MODEL="Kimi-K2.5"
          ANTHROPIC_DEFAULT_OPUS_MODEL="Kimi-K2.5"
          ANTHROPIC_MODEL="$ANTHROPIC_DEFAULT_SONNET_MODEL"
          shift
          ;;
      esac
    fi
    ;;

  deepseek)
    require_env CLD_DEEPSEEK_ANTHROPIC_AUTH_TOKEN "$provider"

    USE_PROXY=false
    ANTHROPIC_BASE_URL="${CLD_DEEPSEEK_ANTHROPIC_BASE_URL:-https://api.deepseek.com/anthropic}"
    ANTHROPIC_AUTH_TOKEN="$CLD_DEEPSEEK_ANTHROPIC_AUTH_TOKEN"
    ANTHROPIC_DEFAULT_HAIKU_MODEL="deepseek-v4-flash[1m]"
    ANTHROPIC_DEFAULT_SONNET_MODEL="deepseek-v4-pro[1m]"
    ANTHROPIC_DEFAULT_OPUS_MODEL="deepseek-v4-pro[1m]"
    ANTHROPIC_MODEL="$ANTHROPIC_DEFAULT_SONNET_MODEL"

    if [[ "$#" -gt 0 ]]; then
      case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
        pro|sonnet|opus)
          ANTHROPIC_MODEL="$ANTHROPIC_DEFAULT_SONNET_MODEL"
          shift
          ;;
        flash|haiku)
          ANTHROPIC_MODEL="$ANTHROPIC_DEFAULT_HAIKU_MODEL"
          shift
          ;;
      esac
    fi
    ;;

  zenmux)
    require_env CLD_ZENMUX_ANTHROPIC_BASE_URL "$provider"
    require_env CLD_ZENMUX_ANTHROPIC_AUTH_TOKEN "$provider"

    ANTHROPIC_BASE_URL="$CLD_ZENMUX_ANTHROPIC_BASE_URL"
    ANTHROPIC_AUTH_TOKEN="$CLD_ZENMUX_ANTHROPIC_AUTH_TOKEN"
    ANTHROPIC_DEFAULT_HAIKU_MODEL="anthropic/claude-haiku-4.5"
    ANTHROPIC_DEFAULT_SONNET_MODEL="anthropic/claude-sonnet-4.5"
    ANTHROPIC_DEFAULT_OPUS_MODEL="anthropic/claude-opus-4.5"
    ANTHROPIC_MODEL="$ANTHROPIC_DEFAULT_SONNET_MODEL"
    API_TIMEOUT_MS="30000000"

    if [[ "$#" -gt 0 ]]; then
      case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
        haiku)
          ANTHROPIC_MODEL="$ANTHROPIC_DEFAULT_HAIKU_MODEL"
          shift
          ;;
        sonnet)
          ANTHROPIC_MODEL="$ANTHROPIC_DEFAULT_SONNET_MODEL"
          shift
          ;;
        opus)
          ANTHROPIC_MODEL="$ANTHROPIC_DEFAULT_OPUS_MODEL"
          shift
          ;;
      esac
    fi
    ;;

  cfuse)
    exec_cfuse_passthrough "$@"
    ;;

  -h|--help|help)
    usage
    exit 0
    ;;

  *)
    echo "Unsupported provider: $provider (supported: anthropic, ant, deepseek, moonshot, zenmux, cfuse)" >&2
    usage
    exit 1
    ;;
esac

if [[ -z "$CLAUDE_BIN" || ! -x "$CLAUDE_BIN" ]]; then
  echo "Error: claude command not found or not executable: ${CLAUDE_BIN:-<unset>}" >&2
  exit 127
fi

check_claude_update

ENV_ARGS=()

[[ -n "$ANTHROPIC_BASE_URL" ]] && ENV_ARGS+=(ANTHROPIC_BASE_URL="$ANTHROPIC_BASE_URL")
[[ -n "$ANTHROPIC_AUTH_TOKEN" ]] && ENV_ARGS+=(ANTHROPIC_AUTH_TOKEN="$ANTHROPIC_AUTH_TOKEN")
[[ -n "$ANTHROPIC_MODEL" ]] && ENV_ARGS+=(ANTHROPIC_MODEL="$ANTHROPIC_MODEL")
[[ -n "$API_TIMEOUT_MS" ]] && ENV_ARGS+=(API_TIMEOUT_MS="$API_TIMEOUT_MS")
[[ -n "$ANTHROPIC_API_KEY" ]] && ENV_ARGS+=(ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY")
[[ -n "$ANTHROPIC_DEFAULT_HAIKU_MODEL" ]] && ENV_ARGS+=(ANTHROPIC_DEFAULT_HAIKU_MODEL="$ANTHROPIC_DEFAULT_HAIKU_MODEL")
[[ -n "$ANTHROPIC_DEFAULT_SONNET_MODEL" ]] && ENV_ARGS+=(ANTHROPIC_DEFAULT_SONNET_MODEL="$ANTHROPIC_DEFAULT_SONNET_MODEL")
[[ -n "$ANTHROPIC_DEFAULT_OPUS_MODEL" ]] && ENV_ARGS+=(ANTHROPIC_DEFAULT_OPUS_MODEL="$ANTHROPIC_DEFAULT_OPUS_MODEL")
[[ -n "$CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC" ]] && ENV_ARGS+=(CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="$CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC")

if [[ "$USE_PROXY" == "true" ]]; then
  ENV_ARGS+=(https_proxy="http://127.0.0.1:7897")
  ENV_ARGS+=(http_proxy="http://127.0.0.1:7897")
  ENV_ARGS+=(all_proxy="socks5://127.0.0.1:7897")
  ENV_ARGS+=(NO_PROXY=".alipay.com,alipay.com,localhost,127.0.0.1")
  ENV_ARGS+=(no_proxy=".alipay.com,alipay.com,localhost,127.0.0.1")
fi

if [[ "$CAST_RECORD" == "1" && "${AGENT_CAST_ACTIVE:-0}" != "1" ]]; then
  CAST_DIR="${AGENT_CAST_DIR:-$HOME/code/ant/agent-casts}"
  mkdir -p "$CAST_DIR"
  CAST_TS="$(date +%Y%m%d-%H%M%S)"
  CAST_FILE="$CAST_DIR/cld-$CAST_TS.cast"
  # Export env vars into THIS process so asciinema's child inherits them.
  # Never put them in --command: that string lands in the cast header and ps output.
  for ea in "${ENV_ARGS[@]}"; do
    export "${ea?}"
  done
  export AGENT_CAST_ACTIVE=1 USE_PROXY="$USE_PROXY"
  CMD_STR="$(printf '%q ' "$CLAUDE_BIN" --dangerously-skip-permissions "$@")"
  echo "cld: recording to $CAST_FILE" >&2
  exec asciinema rec "$CAST_FILE" --command "$CMD_STR" --return
fi

exec env "${ENV_ARGS[@]}" "$CLAUDE_BIN" --dangerously-skip-permissions "$@"
