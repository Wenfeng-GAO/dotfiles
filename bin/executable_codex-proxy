#!/bin/bash
# Launch the signed desktop app with explicit proxy settings.
# Do not wrap Chromium in sandbox-exec: its child sandboxes fail to initialize.
# These settings do not guarantee that every background process avoids direct connections.
set -euo pipefail

app="/Applications/ChatGPT.app/Contents/MacOS/ChatGPT"
proxy="http://127.0.0.1:7897"

export HTTP_PROXY="$proxy" HTTPS_PROXY="$proxy"
export http_proxy="$proxy" https_proxy="$proxy"
export WS_PROXY="$proxy" WSS_PROXY="$proxy"
export ws_proxy="$proxy" wss_proxy="$proxy"
export ALL_PROXY="$proxy" all_proxy="$proxy"
export NO_PROXY="localhost,127.0.0.1,::1"
export no_proxy="$NO_PROXY"
export NODE_USE_ENV_PROXY=1
export ELECTRON_GET_USE_PROXY=1
export CODEX_APP_SERVER_USE_LOCAL_DAEMON=0

if [[ ! -x "$app" ]]; then
  echo "找不到 ChatGPT 应用。" >&2
  exit 1
fi

case "${1:-}" in
  --check)
    echo "检查代理连接……"
    /usr/bin/curl \
      --silent --show-error --proxy "$proxy" \
      --connect-timeout 5 --max-time 10 --output /dev/null \
      --write-out '代理请求 HTTP %{http_code}\n' \
      https://chatgpt.com/
    echo "代理检查完成；未验证所有后台进程，也不保证全进程禁止直连。"
    exit 0
    ;;
  "")
    ;;
  *)
    echo "用法：codex-proxy [--check]" >&2
    exit 2
    ;;
esac

# An existing singleton keeps its original environment and proxy settings.
if /usr/bin/pgrep -f '^/Applications/ChatGPT.app/Contents/MacOS/ChatGPT( |$)' >/dev/null; then
  echo "ChatGPT / Codex 已运行。请先完整退出应用，再运行 codex-proxy。" >&2
  echo "已有进程无法通过再次启动获得新的代理设置。" >&2
  exit 1
fi

if ! /usr/bin/nc -z -w 2 127.0.0.1 7897; then
  echo "Clash 代理 127.0.0.1:7897 未运行，取消启动；不会回退直连。" >&2
  exit 1
fi

exec "$app" \
  "--proxy-server=$proxy" \
  "--proxy-bypass-list=localhost;127.0.0.1;[::1]" \
  --disable-quic
