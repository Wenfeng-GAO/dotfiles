#!/usr/bin/env bash

set -euo pipefail

CODEX_BIN="${CODEX_BIN:-}"

check_codex_update() {
  if [[ "${CDXB_SKIP_UPDATE_CHECK:-}" == "1" ]]; then
    return
  fi

  if ! command -v npm >/dev/null 2>&1; then
    return
  fi

  local current_version latest_version reply

  current_version="$("$CODEX_BIN" --version 2>/dev/null | awk '{print $NF}' || true)"
  latest_version="$(npm view @openai/codex version 2>/dev/null || true)"

  if [[ -z "$current_version" || -z "$latest_version" || "$current_version" == "$latest_version" ]]; then
    return
  fi

  echo "cdxb: codex update available: $current_version -> $latest_version" >&2

  if [[ -t 0 && -t 2 ]]; then
    printf "cdxb: update codex to %s now? [y/N] " "$latest_version" >&2
    read -r reply

    case "$reply" in
      y|Y|yes|YES)
        if ! npm install -g @openai/codex@latest; then
          echo "cdxb: codex update failed; continuing with $current_version" >&2
        fi
        ;;
      *)
        ;;
    esac
  else
    echo "cdxb: run: npm install -g @openai/codex@latest" >&2
  fi
}

if [[ -z "$CODEX_BIN" ]]; then
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [[ -s "$NVM_DIR/nvm.sh" ]]; then
    # Prefer the codex installed under the active nvm Node version.
    # shellcheck disable=SC1090
    . "$NVM_DIR/nvm.sh"
    nvm use --silent default >/dev/null 2>&1 || true
  fi

  if [[ -n "${NVM_BIN:-}" && -x "${NVM_BIN}/codex" ]]; then
    CODEX_BIN="${NVM_BIN}/codex"
  else
    CODEX_BIN="$(command -v codex || true)"
  fi
fi

if [[ -z "$CODEX_BIN" ]]; then
  echo "cdxb: codex not found in PATH" >&2
  exit 127
fi

check_codex_update

exec env \
  https_proxy=http://127.0.0.1:7897 \
  http_proxy=http://127.0.0.1:7897 \
  all_proxy=socks5://127.0.0.1:7897 \
  NO_PROXY=.alipay.com,alipay.com,localhost,127.0.0.1 \
  no_proxy=.alipay.com,alipay.com,localhost,127.0.0.1 \
  "$CODEX_BIN" --dangerously-bypass-approvals-and-sandbox "$@"
