#!/usr/bin/env bash

set -euo pipefail

GROK_BIN="${GROK_BIN:-}"

if [[ -z "$GROK_BIN" ]]; then
  if [[ -x "$HOME/.grok/bin/grok" ]]; then
    GROK_BIN="$HOME/.grok/bin/grok"
  else
    GROK_BIN="$(command -v grok 2>/dev/null || true)"
  fi
fi

if [[ -z "$GROK_BIN" || ! -x "$GROK_BIN" ]]; then
  echo "grokb: grok not found or not executable: ${GROK_BIN:-<unset>}" >&2
  exit 127
fi

# Paperclip injects http://macbook-pro-3:3100. That short hostname does not
# resolve, and HTTP_PROXY intercepts it with 502. The server listens on
# 127.0.0.1:3100, which is already in NO_PROXY.
rewrite_paperclip_loopback() {
  local url="${1:-}"
  case "$url" in
    http://macbook-pro-3:*|http://macbook-pro-3.local:*|http://MacBook-Pro-3:*|http://MacBook-Pro-3.local:*)
      printf 'http://127.0.0.1:%s' "${url##*:}"
      ;;
    *)
      printf '%s' "$url"
      ;;
  esac
}

if [[ -n "${PAPERCLIP_API_URL:-}" ]]; then
  PAPERCLIP_API_URL="$(rewrite_paperclip_loopback "$PAPERCLIP_API_URL")"
  export PAPERCLIP_API_URL
fi
if [[ -n "${PAPERCLIP_RUNTIME_API_URL:-}" ]]; then
  PAPERCLIP_RUNTIME_API_URL="$(rewrite_paperclip_loopback "$PAPERCLIP_RUNTIME_API_URL")"
  export PAPERCLIP_RUNTIME_API_URL
fi

NO_PROXY_VALUE=".alipay.com,alipay.com,localhost,127.0.0.1,macbook-pro-3,macbook-pro-3.local,MacBook-Pro-3,MacBook-Pro-3.local,.local"

# Paperclip's grok_local adapter already supplies --always-approve. Keep this
# wrapper usable both directly and through Paperclip without passing the flag
# twice (the Grok CLI rejects duplicate occurrences).
APPROVAL_ARGS=()
for arg in "$@"; do
  if [[ "$arg" == "--always-approve" ]]; then
    APPROVAL_ARGS=()
    break
  fi
  APPROVAL_ARGS=(--always-approve)
done
if [[ $# -eq 0 ]]; then
  APPROVAL_ARGS=(--always-approve)
fi

exec env \
  https_proxy=http://127.0.0.1:7897 \
  http_proxy=http://127.0.0.1:7897 \
  HTTPS_PROXY=http://127.0.0.1:7897 \
  HTTP_PROXY=http://127.0.0.1:7897 \
  all_proxy=socks5://127.0.0.1:7897 \
  ALL_PROXY=socks5://127.0.0.1:7897 \
  NO_PROXY="$NO_PROXY_VALUE" \
  no_proxy="$NO_PROXY_VALUE" \
  "$GROK_BIN" "${APPROVAL_ARGS[@]}" "$@"
